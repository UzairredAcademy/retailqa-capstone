{
  "name": "retailqe-capstone",
  "version": "0.2.0",
  "private": true,
  "description": "RetailQE - Cypress, Postman and SQL automation framework for the Lewis Retail Group delivery module",
  "scripts": {
    "cy:open": "cypress open",
    "test:ui": "cypress run",
    "test:ui:chrome": "cypress run --browser chrome",
    "test:ui:firefox": "cypress run --browser firefox",
    "test:ui:edge": "cypress run --browser edge",
    "test:xbr:chrome": "cypress run --browser chrome --spec cypress/e2e/cross-browser.cy.js",
    "test:xbr:firefox": "cypress run --browser firefox --spec cypress/e2e/cross-browser.cy.js",
    "test:xbr:edge": "cypress run --browser edge --spec cypress/e2e/cross-browser.cy.js",
    "test:api": "node postman/run-newman.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "quality": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cypress": "^13.0.0",
    "cypress-mochawesome-reporter": "^3.8.0",
    "eslint": "^9.0.0",
    "eslint-plugin-cypress": "^3.5.0",
    "globals": "^15.0.0",
    "newman": "^5.0.0",
    "newman-reporter-htmlextra": "^1.23.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
